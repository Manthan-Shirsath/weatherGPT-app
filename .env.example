# ============================================================================
# weatherGPT - Environment Configuration
# ============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Docker Compose reads this file automatically.

# ----------------------------------------------------------------------------
# 1. AI Weather Agent LLM Provider Configuration
# ----------------------------------------------------------------------------
# Choose provider: 'groq' (default, blazing fast) or 'sarvam' (Indic language optimized)
LLM_PROVIDER=groq

# Groq API Key (Get free at: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Sarvam AI (Optional alternative for enhanced Indic/Marathi performance)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# ----------------------------------------------------------------------------
# 2. Database & Cache (Docker handles internal networking automatically)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/skycast_weather
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# 3. Cache TTLs & Polling Intervals (Seconds)
# ----------------------------------------------------------------------------
TTL_CURRENT_WEATHER=300
TTL_MAP_WEATHER=300
TTL_FORECAST=900
TTL_RADAR_META=180
TTL_ALERTS=600
COLLECTOR_POLL_INTERVAL=180

# ----------------------------------------------------------------------------
# 4. Frontend Map Provider Keys (Optional / Client-side)
# ----------------------------------------------------------------------------
# MapTiler (Free tier: 100,000 requests/mo at https://cloud.maptiler.com)
VITE_MAPTILER_KEY=

# OpenWeatherMap (Weather Tile Overlays: clouds, rain, wind, temp)
VITE_OWM_KEY=

# Mapbox (Optional fallback)
VITE_MAPBOX_TOKEN=
