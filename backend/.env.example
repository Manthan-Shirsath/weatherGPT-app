# ============================================================================
# SkyCast Weather Engine - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# CORE CONFIGURATION
# ============================================================================

# LLM Provider Configuration (Groq / Sarvam)
# ============================================================================
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Alternative Provider: Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_KEY_FALLBACK=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b


# ============================================================================
# DATABASE & CACHE (Optional - app gracefully degrades without them)
# ============================================================================

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/skycast_weather

# Redis Cache URL (Optional: defaults to in-memory fallback if Redis is unavailable)
REDIS_URL=redis://127.0.0.1:6379/0

# Optional External Weather API Keys (For multi-source radar/alerts)
GOOGLE_WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Direct Open-Meteo API Endpoints (Local-First Default)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# ============================================================================
# IMD/WIS2.0 CONFIGURATION (New in MODIFICATION_PROMPT.md Section 1)
# ============================================================================

# Enable IMD/WIS2.0 MQTT live mode (default: false, uses fixture)
# When false: reads from backend/app/services/providers/fixtures/wis2_sample_bulletin.json
# When true: requires WIS2_BROKER_URL, WIS2_USERNAME, WIS2_PASSWORD
IMD_LIVE_MODE=false

# WIS2.0 MQTT Broker URL (required if IMD_LIVE_MODE=true)
# Example: mqtt://wis2.imdpune.gov.in:1883
WIS2_BROKER_URL=

# WIS2.0 MQTT Credentials (required if IMD_LIVE_MODE=true)
WIS2_USERNAME=
WIS2_PASSWORD=

# ============================================================================
# CACHE TIME-TO-LIVE (in seconds)
# ============================================================================

TTL_CURRENT_WEATHER=300        # 5 minutes
TTL_MAP_WEATHER=300            # 5 minutes
TTL_FORECAST=900               # 15 minutes
TTL_RADAR_META=180             # 3 minutes
TTL_ALERTS=600                 # 10 minutes
TTL_GOOGLE_ALERTS=600          # 10 minutes
TTL_OPENWEATHER_ALERTS=600     # 10 minutes

# ============================================================================
# BACKGROUND COLLECTOR
# ============================================================================

# How often the background collector polls weather data and broadcasts updates (in seconds)
COLLECTOR_POLL_INTERVAL=180    # 3 minutes

# ============================================================================
# ALERT THRESHOLDS (Configurable Alert Detection)
# ============================================================================

# Rainfall thresholds (in mm and probability %)
ALERT_RAIN_EXTREME_PRECIP=25.0
ALERT_RAIN_EXTREME_PROB=90
ALERT_RAIN_SEVERE_PRECIP=10.0
ALERT_RAIN_SEVERE_PROB=70
ALERT_RAIN_MOD_PRECIP=2.0
ALERT_RAIN_MOD_PROB=35

# Wind thresholds (in kmh)
ALERT_WIND_EXTREME=60.0
ALERT_WIND_SEVERE=38.0
ALERT_WIND_MOD=24.0

# Temperature thresholds (in Celsius)
ALERT_TEMP_EXTREME_HEAT=42.0
ALERT_TEMP_SEVERE_HEAT=37.0
ALERT_TEMP_MOD_HEAT=33.0
ALERT_TEMP_EXTREME_COLD=3.0
ALERT_TEMP_SEVERE_COLD=7.0

# UV Index thresholds
ALERT_UV_EXTREME=11.0
ALERT_UV_SEVERE=8.0
ALERT_UV_MOD=6.0

# Visibility/Fog thresholds (in km)
ALERT_VIS_EXTREME=0.5
ALERT_VIS_SEVERE=1.5
ALERT_VIS_MOD=3.0

# ============================================================================
# ROLE-ADAPTIVE RESPONSES (New in MODIFICATION_PROMPT.md Section 2)
# ============================================================================

# Enable role-adaptive response formatting (default: true)
ENABLE_ROLE_ADAPTIVE_RESPONSES=true

# Default user role if not specified in chat request
# Options: general_public, farmer, disaster_manager, aviation, researcher, marine, urban_planner
DEFAULT_USER_ROLE=general_public

# ============================================================================
# MULTILINGUAL & TRANSLATION (New in MODIFICATION_PROMPT.md Section 3)
# ============================================================================

# Target language for Gemini LLM responses
# Language context is passed to Gemini system prompt
# Options: en, hi, ta, te, ml, bn, gu, ka, or, pa, mr
DEFAULT_RESPONSE_LANGUAGE=en

# Enable Bhashini translation provider stub (default: false)
USE_BHASHINI=false

# Bhashini API credentials (optional, for future production integration)
BHASHINI_API_KEY=
BHASHINI_URL=

# ============================================================================
# ALERT DISSEMINATION (New in MODIFICATION_PROMPT.md Section 4)
# ============================================================================

# Enable proactive alert subscriptions and threshold-crossing notifications (default: false)
ENABLE_PROACTIVE_ALERTS=false

# SMS/IVR Channel Configuration (stubbed for now)
ENABLE_SMS_CHANNEL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# SYSTEM METRICS & MONITORING (New in MODIFICATION_PROMPT.md Section 5)
# ============================================================================

# Enable system metrics endpoint (/api/system/metrics)
ENABLE_METRICS=true

# Expose metrics in debug/admin panel (default: true)
METRICS_DASHBOARD_ENABLED=true

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable CORS for all origins (set to false in production)
CORS_ALLOW_ALL=true

# ============================================================================
# NLP MODE (New in NLP_DYNAMIC_UI_PROMPT.md)
# ============================================================================

# Enable deterministic NLP router instead of LLM orchestration (default: false)
NLP_MODE=false
